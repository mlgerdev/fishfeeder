{
  "build": {
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "memory_type": "qio_opi"
    },
    "core": "esp32",
    "extra_flags": "-DARDUINO_WAVESHARE_ESP32S3_LCD43B -DARDUINO_ARCH_ESP32 -DARDUINO_USB_MODE=1 -DARDUINO_USB_CDC_ON_BOOT=1",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "hwids": [
      ["0x303A", "0x1001"],
      ["0x1A86", "0x55D4"]
    ],
    "mcu": "esp32s3",
    "variant": "esp32s3"
  },
  "connectivity": ["bluetooth", "wifi"],
  "debug": {
    "default_tool": "esp-builtin",
    "onboard_tools": ["esp-builtin"],
    "openocd_target": "esp32s3.cfg"
  },
  "frameworks": ["arduino", "espidf"],
  "name": "Waveshare ESP32-S3-Touch-LCD-4.3B (16MB flash, 8MB OPI PSRAM)",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram": 327680,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 921600,
    "wait_for_upload_port": true
  },
  "url": "https://www.waveshare.com/esp32-s3-touch-lcd-4.3b.htm",
  "vendor": "Waveshare"
}
